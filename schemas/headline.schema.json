{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "passk headline (standard contract, schema_version 1)",
  "description": "Generated by scripts/render_readme.py from results JSON only. Every value is a formatted string from a committed result; an item is present only when its source exists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "tagline",
    "quickstart",
    "environment",
    "items",
    "links"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "tool": {
      "const": "passk"
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "quickstart": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "site",
        "release"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "format": "uri"
        },
        "site": {
          "type": "string",
          "format": "uri"
        },
        "release": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "value",
        "detail",
        "n",
        "ci",
        "synthetic",
        "featured",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        },
        "n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ci": {
          "type": [
            "string",
            "null"
          ]
        },
        "synthetic": {
          "type": "boolean"
        },
        "featured": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "pattern": "^results/.+\\.json$"
        }
      }
    }
  }
}
